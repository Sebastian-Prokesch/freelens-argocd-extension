{
  "$schema": "https://unpkg.com/knip@5/schema-jsonc.json",

  "entry": [
    "dist/{main,renderer}.js!",
    "src/main/index.ts",
    "src/renderer/index.tsx",
    "vitest.config.ts",
    "vitest.integration.config.ts"
  ],
  "project": ["*.{js,mjs,ts}", "build/**/*.mjs", "dist/**/*.js!", "src/**/*.{ts,tsx}", "integration/**/*.ts"],

  "ignoreBinaries": ["build:.*"],
  "ignoreDependencies": [
    // provided by the application
    "@freelensapp/extensions",
    // host-provided singletons: marked external at build time, installed for types and unit tests
    "react",
    "react-dom",
    "mobx",
    "mobx-react",
    "electron",
    // used by build/vite-plugin-standard-decorators.mjs
    "esbuild",
    // CSS modules are compiled by Vite
    "sass-embedded"
  ],

  "typescript": {
    "config": ["tsconfig.json"]
  },
  "vite": {
    "config": ["vite.config.mjs"]
  },

  "exclude": ["exports"]
}
